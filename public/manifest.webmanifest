{
  "id": "https://clubedasleitoras.com.br",
  "name": "Clube das Leitoras",
  "short_name": "ClubeLeitoras",
  "description": "Clube de leitura em Brasília com encontros, dicas e livro do mês.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#B04D4A",
  "background_color": "#FDFCFB",
  "icons": [
    {
      "src": "/icon-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    { "src": "/screenshot-1.png", "sizes": "1200x800", "type": "image/png" },
    { "src": "/screenshot-2.png", "sizes": "1200x800", "type": "image/png" }
  ],
  "categories": ["education", "books"],
  "shortcuts": [
    {
      "name": "Livro do mês",
      "short_name": "Livro",
      "description": "Ir para o livro do mês",
      "url": "/livro-do-mes",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Eventos",
      "short_name": "Eventos",
      "description": "Ver cronograma de eventos",
      "url": "/eventos",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/?share_target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*"]
        }
      ]
    }
  },
  "protocol_handlers": [
    { "protocol": "web+clubedasleitoras", "url": "https://clubedasleitoras.com.br/?url=%s" }
  ],
  "file_handlers": [
    {
      "action": "/?file_handling",
      "accept": {
        "application/pdf": [".pdf"],
        "text/plain": [".txt"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "auto"
  },
  "prefer_related_applications": false,
  "related_applications": [
    { "platform": "webapp", "url": "https://clubedasleitoras.com.br" }
  ],
  "iarc_rating_id": "e1e6f123-4567-89ab-cdef-0123456789ab",
  "display_override": ["standalone", "fullscreen"],
  "widgets": [
    {
      "name": "ClubeWidget",
      "description": "Acesso rápido aos livros do mês",
      "url": "/widget.html",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "edge_side_panel": {
    "edge_side_panel_page": "https://clubedasleitoras.com.br/side-panel"
  },
  "note_taking": { "id": "clube-notes", "name": "Clube Notes" },
  "lang": "pt-BR",
  "dir": "ltr"
}
